// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum QuoteStatus {
  DRAFT        // Just created, not yet sent to client
  SENT         // Sent to client for review
  ACCEPTED     // Client accepted the quote
  REJECTED     // Client rejected the quote
  CANCELLED    // Cancelled internally
}

enum SalesOrderStatus {
  PENDING            // Quote accepted, no initial payment yet
  DEPOSIT_PAID       // Deposit received (payment on acceptance)
  DELIVERED          // Furniture delivered, pending final payment
  COMPLETED          // Both payments received, process closed
  VOIDED             // Sales order voided
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHECK
}

enum PaymentType {
  DEPOSIT            // Payment on quote acceptance
  CASH_ON_DELIVERY   // Payment at delivery
  PARTIAL_PAYMENT    // Optional additional partial payment
}

enum ProductCategory {
  LIVING_ROOM
  DINING_ROOM
  BEDROOM
  OFFICE
  OUTDOOR
  OTHER
}

// ─────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────

model Client {
  id           Int      @id @default(autoincrement())
  nui     String   @unique @db.VarChar(20)   // National ID / RUC
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  email        String?  @db.VarChar(150)
  mobile       String?  @db.VarChar(20)
  address      String?  @db.VarChar(255)
  city         String?  @db.VarChar(100)
  notes        String?  @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quotes       Quote[]

  @@map("clients")
}

// ─────────────────────────────────────────────
// PRODUCT CATALOG
// ─────────────────────────────────────────────

/// Individual product (e.g., triple sofa, double sofa, center table)
model Product {
  id            Int             @id @default(autoincrement())
  sku           String          @unique @db.VarChar(30)
  name          String          @db.VarChar(150)
  description   String?         @db.Text
  category      ProductCategory @default(OTHER)
  basePrice     Decimal         @db.Decimal(10, 2)
  isActive      Boolean         @default(true)
  laborCost     Decimal         @default(0.00) @db.Decimal(10, 2)
  profitMargin  Float           @default(0.00)
  imageUrl      String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  setItems      SetItem[]
  quoteItems QuoteItem[]

  @@map("products")
}

/// Furniture set (e.g., "Venecia Living Room Set", "6-Seat Dining Set")
model FurnitureSet {
  id          Int             @id @default(autoincrement())
  sku         String          @unique @db.VarChar(30)
  description String?         @db.Text
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  setItems    SetItem[]

  @@map("furniture_sets")
}

/// N:M relationship between FurnitureSet and Product with quantity
/// e.g., Living Room Set → 1 triple + 1 double + 1 single + 1 center table
model SetItem {
  id             Int          @id @default(autoincrement())
  furnitureSetId Int
  productId      Int
  quantity       Int          @default(1)
  sortOrder      Int          @default(0)  // Display order within the set

  furnitureSet   FurnitureSet @relation(fields: [furnitureSetId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([furnitureSetId, productId])
  @@map("set_items")
}

// ─────────────────────────────────────────────
// QUOTE (PROFORMA)
// ─────────────────────────────────────────────

model Quote {
  id               Int         @id @default(autoincrement())
  number           String      @unique @db.VarChar(20)  // e.g., QUO-2024-0001
  clientId         Int
  status           QuoteStatus @default(DRAFT)

  // Pricing
  discountPercent  Decimal     @default(0) @db.Decimal(5, 2)   // Global discount %
  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)

  // Commercial terms
  deliveryDays     Int?                                          // Estimated business days
  validityDays     Int         @default(15)                      // Quote validity in days
  notes            String?     @db.Text
  internalNotes    String?     @db.Text

  // Key dates
  issuedAt         DateTime    @default(now())
  expiresAt        DateTime?
  acceptedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  client           Client      @relation(fields: [clientId], references: [id])
  items            QuoteItem[]
  salesOrder SalesOrder?

  @@map("quotes")
}

model QuoteItem {
  id               Int          @id @default(autoincrement())
  quoteId          Int
  productId        Int
  quantity         Int          @default(1)

  // Price agreed in the quote (may differ from catalog base price)
  unitPrice        Decimal      @db.Decimal(10, 2)
  discountPercent  Decimal      @default(0) @db.Decimal(5, 2)  // Per-item discount %
  subtotal         Decimal      @db.Decimal(10, 2)

  // Customization / notes for this specific item
  customDetails    String?      @db.Text   // e.g., "black vinyl fabric", "cedar wood"
  sortOrder        Int          @default(0)

  quote            Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

// ─────────────────────────────────────────────
// SALES ORDER & PAYMENTS
// ─────────────────────────────────────────────

/// An accepted quote generates a sales order
model SalesOrder {
  id                   Int              @id @default(autoincrement())
  number               String           @unique @db.VarChar(20)  // e.g., SO-2024-0001
  quoteId              Int              @unique
  status               SalesOrderStatus @default(PENDING)

  // Amounts
  quoteTotal           Decimal          @db.Decimal(10, 2)
  pendingBalance       Decimal          @db.Decimal(10, 2)  // Dynamically calculated

  // Dates
  orderDate            DateTime         @default(now())
  agreedDeliveryDate   DateTime?        // Agreed delivery date
  actualDeliveryDate   DateTime?        // Actual delivery date
  notes                String?          @db.Text

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  quote            Quote    @relation(fields: [quoteId], references: [id])
  payments             Payment[]

  @@map("sales_orders")
}

/// Record of each payment received against a sales order
model Payment {
  id             Int           @id @default(autoincrement())
  salesOrderId   Int
  paymentMethod  PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  // Payment reference (transfer number, check number, etc.)
  notes          String?       @db.Text

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  salesOrder     SalesOrder    @relation(fields: [salesOrderId], references: [id])

  @@map("payments")
}

enum UserRole {
  ADMIN
  SALES
  OPERATOR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(SALES)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}